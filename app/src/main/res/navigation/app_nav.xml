<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_nav"
    app:startDestination="@id/main_nav">

    <include app:graph="@navigation/prelogin_nav" />
    <include app:graph="@navigation/main_nav" />

    <action
        android:id="@+id/action_mainNav_to_preloginNav"
        app:destination="@id/prelogin_nav"
        app:popUpTo="@id/app_nav"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_preloginNavto_mainNav"
        app:destination="@id/main_nav"
        app:popUpTo="@id/app_nav"
        app:popUpToInclusive="true" />

</navigation>