    <style name="Theme.Ecommerce" parent="Base.Theme.Ecommerce">
        <item name="android:windowSoftInputMode">adjustPan</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
<!--        <item name="windowSplashScreenAnimatedIcon">@drawable/news_avd_v02_static</item>-->
        <item name="windowSplashScreenAnimatedIcon">@drawable/animated_splash_icon_static</item>
