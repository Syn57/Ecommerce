<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="12dp">

    <ImageView
        android:id="@+id/iv_item_icon_search_search_dialog"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_item_icon_arrow_search_dialog"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_arrow_foward"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_item_recommendation_search_dialog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_item_icon_arrow_search_dialog"
        app:layout_constraintEnd_toStartOf="@id/iv_item_icon_arrow_search_dialog"
        app:layout_constraintStart_toEndOf="@id/iv_item_icon_search_search_dialog"
        app:layout_constraintTop_toTopOf="@id/iv_item_icon_arrow_search_dialog"
        tools:text="Lenovo Legion 7" />

</androidx.constraintlayout.widget.ConstraintLayout>