<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iv_item_notification_img_thumbnail"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/thumbnail_load_product"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_item_notification_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/poppins_400"
        android:text="@string/info"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/iv_item_notification_img_thumbnail"
        app:layout_constraintTop_toTopOf="@id/iv_item_notification_img_thumbnail" />

    <TextView
        android:id="@+id/tv_item_notification_success"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/poppins_600"
        android:text="@string/transaction_successful"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_item_notification_img_thumbnail"
        app:layout_constraintTop_toBottomOf="@id/tv_item_notification_info" />

    <TextView
        android:id="@+id/tv_item_notification_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/poppins_400"
        android:text="@string/lorem"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_item_notification_img_thumbnail"
        app:layout_constraintTop_toBottomOf="@id/tv_item_notification_success" />

    <TextView
        android:id="@+id/tv_item_notification_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/poppins_400"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_item_notification_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_item_notification_info"
        tools:text="12 Jun 2023, 11:45" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_item_notification_description"
        app:layout_constraintTop_toBottomOf="@id/tv_item_notification_description" />
</androidx.constraintlayout.widget.ConstraintLayout>