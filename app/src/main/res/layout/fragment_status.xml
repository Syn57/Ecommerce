<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.status.StatusFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_checkout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/tb_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/status"
            app:titleCentered="true" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/abl_checkout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <ImageView
                android:id="@+id/iv_status_bg_profile"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:elevation="3dp"
                android:src="@drawable/bg_profile_review"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toStartOf="@id/cv_status"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:elevation="3dp"
                android:src="@drawable/ic_check"
                app:layout_constraintBottom_toBottomOf="@id/iv_status_bg_profile"
                app:layout_constraintEnd_toEndOf="@id/iv_status_bg_profile"
                app:layout_constraintStart_toStartOf="@id/iv_status_bg_profile"
                app:layout_constraintTop_toTopOf="@id/iv_status_bg_profile" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="64dp"
                android:elevation="0dp"
                app:cardCornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_status_payment_success"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="48dp"
                        android:fontFamily="@font/poppins_600"
                        android:gravity="center"
                        android:text="@string/payment_success"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <RatingBar
                        android:id="@+id/rb_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@id/tv_status_payment_success"
                        app:layout_constraintStart_toStartOf="@id/tv_status_payment_success"
                        app:layout_constraintTop_toBottomOf="@id/tv_status_payment_success" />

                    <TextView
                        android:id="@+id/tv_status_leave_review"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_600"
                        android:text="@string/leave_a_review"
                        app:layout_constraintEnd_toEndOf="@id/tv_status_payment_success"
                        app:layout_constraintStart_toStartOf="@id/tv_status_payment_success"
                        app:layout_constraintTop_toBottomOf="@id/rb_status" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_status_review"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:elevation="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_status_payment_success"
                        app:layout_constraintStart_toStartOf="@id/tv_status_payment_success"
                        app:layout_constraintTop_toBottomOf="@id/tv_status_leave_review">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_status_review"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/poppins_400"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:maxLines="5"
                            android:scrollbars="vertical"
                            android:scrollHorizontally="false"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_status_transaction_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_600"
                android:text="@string/transaction_detail"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toStartOf="@id/cv_status"
                app:layout_constraintTop_toBottomOf="@id/cv_status" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/dvdr_status_anchor"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_status_transaction_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_400"
                android:text="@string/transaction_id"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/dvdr_status_anchor"
                app:layout_constraintStart_toStartOf="@id/tv_status_transaction_detail"
                app:layout_constraintTop_toTopOf="@+id/tv_status_transaction_id_value" />

            <TextView
                android:id="@+id/tv_status_transaction_id_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_600"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toEndOf="@id/dvdr_status_anchor"
                app:layout_constraintTop_toBottomOf="@id/tv_status_transaction_detail"
                tools:text="abcd-efgh-kslvn-kdsov" />

            <TextView
                android:id="@+id/tv_status_transaction_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_400"
                android:text="@string/status"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/dvdr_status_anchor"
                app:layout_constraintStart_toStartOf="@id/tv_status_transaction_detail"
                app:layout_constraintTop_toTopOf="@+id/tv_status_transaction_status_value" />

            <TextView
                android:id="@+id/tv_status_transaction_status_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_600"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toEndOf="@id/dvdr_status_anchor"
                app:layout_constraintTop_toBottomOf="@id/tv_status_transaction_id_value"
                tools:text="Success" />

            <TextView
                android:id="@+id/tv_status_transaction_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_400"
                android:text="@string/date"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/dvdr_status_anchor"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="@id/tv_status_transaction_detail"
                app:layout_constraintTop_toTopOf="@+id/tv_status_transaction_date_value" />

            <TextView
                android:id="@+id/tv_status_transaction_date_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_600"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toEndOf="@id/dvdr_status_anchor"
                app:layout_constraintTop_toBottomOf="@id/tv_status_transaction_status_value"
                tools:text="3 Juli 2023" />

            <TextView
                android:id="@+id/tv_status_transaction_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_400"
                android:text="@string/time"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/dvdr_status_anchor"
                app:layout_constraintStart_toStartOf="@id/tv_status_transaction_detail"
                app:layout_constraintTop_toTopOf="@+id/tv_status_transaction_time_value" />

            <TextView
                android:id="@+id/tv_status_transaction_time_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_600"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toEndOf="@id/dvdr_status_anchor"
                app:layout_constraintTop_toBottomOf="@id/tv_status_transaction_date_value"
                tools:text="22.00" />

            <TextView
                android:id="@+id/tv_status_transaction_payment_method"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_400"
                android:text="@string/payment_method"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/dvdr_status_anchor"
                app:layout_constraintStart_toStartOf="@id/tv_status_transaction_detail"
                app:layout_constraintTop_toTopOf="@+id/tv_status_transaction_payment_method_value" />

            <TextView
                android:id="@+id/tv_status_transaction_payment_method_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_600"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toEndOf="@id/dvdr_status_anchor"
                app:layout_constraintTop_toBottomOf="@id/tv_status_transaction_time_value"
                tools:text="BCA Virtual Account" />

            <TextView
                android:id="@+id/tv_status_transaction_total_payment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_400"
                android:text="@string/total_payment"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/dvdr_status_anchor"
                app:layout_constraintStart_toStartOf="@id/tv_status_transaction_detail"
                app:layout_constraintTop_toTopOf="@+id/tv_status_transaction_total_payment_value" />

            <TextView
                android:id="@+id/tv_status_transaction_total_payment_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_600"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toEndOf="@id/dvdr_status_anchor"
                app:layout_constraintTop_toBottomOf="@id/tv_status_transaction_payment_method_value"
                tools:text="Rp22.499.000" />

            <Button
                android:id="@+id/btn_status_done"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="@string/done"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toStartOf="@id/cv_status"
                app:layout_constraintTop_toBottomOf="@id/tv_status_transaction_total_payment_value"
                app:layout_constraintVertical_bias="1" />

            <ProgressBar
                android:id="@+id/pb_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@id/btn_status_done"
                app:layout_constraintEnd_toEndOf="@id/btn_status_done"
                app:layout_constraintStart_toStartOf="@id/btn_status_done"
                app:layout_constraintTop_toTopOf="@id/btn_status_done" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/materialDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toTopOf="@id/btn_status_done" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
