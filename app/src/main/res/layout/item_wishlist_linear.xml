<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="2dp"
    android:id="@+id/cv_wishlist_linear"
    android:layout_marginVertical="2dp"
    android:elevation="3dp"
    android:stateListAnimator="@animator/list_animation_pressed"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_item_wishlist_linear_img"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/thumbnail_load_product"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/customRoundedImageView8dp" />

        <TextView
            android:id="@+id/tv_item_wishlist_linear_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/poppins_400"
            android:maxLines="2"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/tv_item_wishlist_linear_price"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_item_wishlist_linear_img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            tools:text="Lenovo Legion 7 16 I7 11800 16GB 1TB SSD RTX3070 8GB" />

        <TextView
            android:id="@+id/tv_item_wishlist_linear_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/poppins_600"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/iv_item_wishlist_linear_ic_store_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_item_wishlist_linear_img"
            app:layout_constraintTop_toBottomOf="@id/tv_item_wishlist_linear_product_name"
            tools:text="Rp. 27.000.0000" />

        <ImageView
            android:id="@+id/iv_item_wishlist_linear_ic_store_profile"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:src="@drawable/ic_person_circle"
            app:layout_constraintBottom_toTopOf="@id/iv_item_wishlist_linear_ic_star"
            app:layout_constraintStart_toEndOf="@id/iv_item_wishlist_linear_img"
            app:layout_constraintTop_toBottomOf="@id/tv_item_wishlist_linear_price" />

        <TextView
            android:id="@+id/tv_item_wishlist_linear_store_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/poppins_400"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_item_wishlist_linear_ic_store_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_item_wishlist_linear_ic_store_profile"
            app:layout_constraintTop_toTopOf="@id/iv_item_wishlist_linear_ic_store_profile"
            tools:text="ProStoreComputer" />

        <ImageView
            android:id="@+id/iv_item_wishlist_linear_ic_star"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="9dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_star"
            app:layout_constraintBottom_toTopOf="@+id/btn_item_wishlist_linear_delete"
            app:layout_constraintStart_toEndOf="@id/iv_item_wishlist_linear_img"
            app:layout_constraintTop_toBottomOf="@id/iv_item_wishlist_linear_ic_store_profile" />

        <TextView
            android:id="@+id/tv_item_wishlist_linear_rating_sold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/poppins_400"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_item_wishlist_linear_ic_star"
            app:layout_constraintStart_toEndOf="@id/iv_item_wishlist_linear_ic_star"
            app:layout_constraintTop_toTopOf="@id/iv_item_wishlist_linear_ic_star"
            tools:text="5.0 | Terjual 90" />

        <Button
            android:id="@+id/btn_item_wishlist_linear_delete"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="4dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="-4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_item_wishlist_linear_img"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btn_item_wishlist_linear_add_chart"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="@string/add_chart"
            app:layout_constraintBottom_toBottomOf="@id/btn_item_wishlist_linear_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_item_wishlist_linear_delete"
            app:layout_constraintTop_toTopOf="@id/btn_item_wishlist_linear_delete" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>